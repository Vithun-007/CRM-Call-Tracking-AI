.app-layout {
  min-height: 100vh;
  display: flex;
  background: #f6f8fc;
}

.sidebar {
  width: 250px;
  flex-shrink: 0;
  min-height: 100vh;
  background: #ffffff;
  border-right: 1px solid #e9edf4;
  display: flex;
  flex-direction: column;
  padding: 25px 17px 16px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 8px 32px;
}

.brand-icon {
  width: 39px;
  height: 39px;
  border-radius: 11px;
  background: #173b70;
  color: white;
  display: grid;
  place-items: center;
}

.brand h1 {
  font-size: 15px;
  letter-spacing: 0.7px;
  margin: 0 0 3px;
  font-weight: 800;
  color: #173b70;
}

.brand span {
  color: #929bad;
  font-size: 11px;
}

.nav-label {
  padding: 0 11px 12px;
  color: #a2aabc;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 1.1px;
}

.navigation {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.nav-item {
  border: 0;
  width: 100%;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 12px 12px;
  border-radius: 8px;
  color: #69758a;
  background: transparent;
  text-align: left;
  font-size: 13px;
  font-weight: 550;
  transition: 0.2s;
}

.nav-item:hover {
  background: #f3f6fb;
  color: #173b70;
}

.nav-active {
  background: #edf3fc;
  color: #19477f;
  font-weight: 700;
}

.sidebar-bottom {
  margin-top: auto;
}

.sidebar-help {
  margin: 25px 3px 20px;
  padding: 16px;
  background: #f4f7fd;
  border: 1px solid #e9eef8;
  border-radius: 11px;
}

.help-icon {
  color: #466eaa;
  margin-bottom: 12px;
}

.sidebar-help h3 {
  font-size: 12px;
  margin: 0 0 7px;
  color: #233b61;
}

.sidebar-help p {
  font-size: 11px;
  line-height: 1.65;
  color: #78859a;
  margin: 0;
}

.profile {
  border-top: 1px solid #edf0f5;
  padding: 17px 4px 3px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.avatar,
.top-avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: #e9eff9;
  color: #244b7e;
  display: grid;
  place-items: center;
  font-size: 12px;
  font-weight: 750;
}

.profile-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.profile-info strong {
  font-size: 11px;
  color: #34425a;
}

.profile-info span {
  color: #98a1b0;
  font-size: 10px;
}

.profile > svg {
  color: #929bad;
}

.main-area {
  flex: 1;
  min-width: 0;
}

.topbar {
  height: 70px;
  padding: 0 38px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  border-bottom: 1px solid #e9edf4;
}

.topbar-left,
.topbar-right {
  display: flex;
  align-items: center;
  gap: 20px;
}

.breadcrumb {
  font-size: 12px;
  color: #909bad;
}

.breadcrumb span {
  margin: 0 9px;
  color: #c1c8d3;
}

.breadcrumb strong {
  color: #33435e;
  font-weight: 650;
}

.topbar-right {
  gap: 19px;
}

.topbar-status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  color: #758198;
}

.status-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  background: #21ad78;
  border-radius: 50%;
}

.icon-button,
.menu-toggle,
.mobile-close {
  background: transparent;
  border: 0;
  color: #78859a;
  display: grid;
  place-items: center;
  padding: 5px;
}

.page-container {
  max-width: 1500px;
  margin: 0 auto;
  padding: 36px 40px 20px;
}

.page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 27px;
}

.eyebrow {
  color: #6380a9;
  font-size: 10px;
  letter-spacing: 1.1px;
  font-weight: 750;
  margin-bottom: 9px;
}

.page-heading h2 {
  color: #172b4d;
  font-size: 25px;
  letter-spacing: -0.5px;
  margin: 0;
  font-weight: 750;
}

.page-heading p {
  color: #8792a5;
  font-size: 12px;
  margin: 9px 0 0;
}

.welcome-panel {
  position: relative;
  overflow: hidden;
  background: linear-gradient(110deg, #183d70, #315d94);
  border-radius: 13px;
  padding: 31px 35px;
  min-height: 195px;
  color: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.welcome-tag {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #c7dcf6;
  font-size: 9px;
  letter-spacing: 1px;
  font-weight: 750;
  margin-bottom: 17px;
}

.welcome-panel h3 {
  font-size: 22px;
  margin: 0 0 10px;
  letter-spacing: -0.4px;
}

.welcome-panel p {
  font-size: 12px;
  color: #d3e0f0;
  max-width: 550px;
  line-height: 1.8;
  margin: 0;
}

.welcome-art {
  position: relative;
  width: 150px;
  height: 125px;
  margin-right: 45px;
  display: grid;
  place-items: center;
}

.art-circle {
  width: 90px;
  height: 90px;
  border: 1px solid #a6c2e3;
  background: #ffffff17;
  border-radius: 25px;
  display: grid;
  place-items: center;
  color: white;
  transform: rotate(-9deg);
}

.art-sparkle {
  position: absolute;
  top: 5px;
  right: 8px;
  color: #b9d7ff;
}

.section-heading {
  margin: 31px 0 17px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-heading h3,
.card-heading h3,
.toolbar h3 {
  font-size: 14px;
  color: #253754;
  margin: 0;
  font-weight: 700;
}

.section-heading p,
.card-heading p,
.toolbar p {
  font-size: 11px;
  color: #929caf;
  margin: 6px 0 0;
}

.data-status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 10px;
  color: #929bad;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.stat-card,
.content-card {
  background: #ffffff;
  border: 1px solid #e9edf4;
  border-radius: 11px;
}

.stat-card {
  padding: 18px;
}

.stat-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #77849a;
  font-size: 11px;
}

.stat-icon,
.quick-icon {
  width: 37px;
  height: 37px;
  border-radius: 9px;
  display: grid;
  place-items: center;
}

.blue {
  background: #edf3fd;
  color: #3974bd;
}

.purple {
  background: #f2edfc;
  color: #8761bf;
}

.green {
  background: #eaf7f1;
  color: #299a70;
}

.orange {
  background: #fff3e8;
  color: #d78b40;
}

.stat-value {
  font-size: 25px;
  font-weight: 750;
  color: #273957;
  margin: 16px 0 5px;
}

.stat-note {
  color: #a0aabb;
  font-size: 10px;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: 1.25fr 1fr;
  gap: 17px;
  margin-top: 20px;
}

.content-card {
  padding: 21px;
}

.quick-actions {
  margin-top: 19px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.quick-action {
  display: flex;
  align-items: center;
  gap: 13px;
  border: 1px solid #edf0f5;
  border-radius: 9px;
  padding: 12px;
  color: #8c98aa;
}

.quick-action > div:nth-child(2) {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.quick-action strong {
  font-size: 11px;
  color: #354660;
}

.quick-action span {
  font-size: 10px;
  color: #9ba5b4;
}

.ai-card {
  background: #f8faff;
  border-color: #e6ecf8;
}

.ai-card-icon {
  width: 39px;
  height: 39px;
  display: grid;
  place-items: center;
  background: #e9f0fc;
  border-radius: 10px;
  color: #4774b4;
  margin-bottom: 14px;
}

.ai-label {
  font-size: 9px;
  letter-spacing: 1px;
  color: #6281af;
  font-weight: 750;
}

.ai-card h3 {
  color: #253d61;
  font-size: 16px;
  margin: 9px 0;
}

.ai-card > p {
  color: #8290a7;
  font-size: 11px;
  line-height: 1.8;
  margin: 0;
}

.ai-feature {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 18px;
  color: #647c9f;
  font-size: 10px;
}

.ai-feature span {
  display: flex;
  align-items: center;
  gap: 8px;
}

.page-card {
  padding: 22px;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
}

.toolbar-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.search-box,
.history-filter {
  height: 38px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 11px;
  border: 1px solid #e7ebf2;
  border-radius: 7px;
  color: #98a3b4;
  font-size: 11px;
}

.search-box input {
  width: 140px;
  border: 0;
  outline: 0;
  font-size: 11px;
}

.primary-button,
.secondary-button {
  border: 0;
  border-radius: 7px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 14px;
  font-size: 11px;
  font-weight: 650;
}

.primary-button {
  color: #ffffff;
  background: #244f85;
}

.secondary-button {
  color: #345b91;
  background: #eaf0fa;
}

.table-placeholder {
  min-height: 300px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 30px;
}

.empty-icon {
  width: 55px;
  height: 55px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: #edf3fb;
  color: #5478aa;
  margin-bottom: 15px;
}

.table-placeholder h3 {
  color: #334763;
  font-size: 13px;
  margin: 0 0 8px;
}

.table-placeholder p {
  color: #929daf;
  font-size: 11px;
  max-width: 380px;
  line-height: 1.7;
  margin: 0;
}

.card-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.draft-label,
.ai-powered-label {
  font-size: 9px;
  font-weight: 750;
  letter-spacing: 0.7px;
  color: #6682aa;
  background: #edf3fb;
  border-radius: 5px;
  padding: 7px 9px;
}

.form-section {
  margin-top: 27px;
  padding-top: 23px;
  border-top: 1px solid #edf0f5;
}

.form-section-title {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #5277aa;
  margin-bottom: 18px;
}

.form-section-title h4 {
  font-size: 12px;
  color: #334763;
  margin: 0;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 17px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #56647b;
  font-size: 11px;
  font-weight: 650;
}

.field input,
.field textarea,
.input-icon {
  width: 100%;
  border: 1px solid #e4e9f1;
  background: #fbfcfe;
  border-radius: 7px;
  padding: 11px 12px;
  outline: none;
  color: #34445f;
  font-size: 11px;
  font-weight: 400;
}

.field textarea {
  resize: vertical;
  line-height: 1.7;
}

.field input:focus,
.field textarea:focus {
  border-color: #7096c9;
}

.input-icon {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #8996aa;
}

.input-icon input {
  border: 0;
  background: transparent;
  padding: 0;
}

.field-hint {
  font-size: 10px;
  color: #9ba5b5;
  margin: 8px 0 0;
}

.ai-summary-panel {
  margin-top: 25px;
  padding: 18px;
  background: #f7f9fe;
  border: 1px solid #e6ecf7;
  border-radius: 10px;
}

.ai-summary-heading {
  display: flex;
  align-items: center;
  gap: 11px;
}

.ai-summary-icon {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  color: #567ab2;
  background: #e9f0fc;
}

.ai-summary-heading > div:nth-child(2) {
  flex: 1;
}

.ai-summary-heading h4 {
  font-size: 12px;
  color: #304667;
  margin: 0 0 5px;
}

.ai-summary-heading p {
  color: #919caf;
  font-size: 10px;
  margin: 0;
}

.summary-placeholder {
  padding: 17px;
  margin: 17px 0;
  background: #ffffff;
  border: 1px dashed #dbe3f0;
  border-radius: 7px;
  color: #a0aabc;
  font-size: 11px;
  line-height: 1.7;
}

.form-footer {
  border-top: 1px solid #edf0f5;
  margin-top: 23px;
  padding-top: 19px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-footer > span {
  font-size: 10px;
  color: #9aa4b3;
}

.app-footer {
  border-top: 1px solid #e9edf4;
  padding-top: 16px;
  margin-top: 35px;
  display: flex;
  justify-content: space-between;
  color: #a0aabb;
  font-size: 9px;
  letter-spacing: 0.5px;
}

.menu-toggle,
.mobile-close,
.mobile-overlay {
  display: none;
}

@media (max-width: 1050px) {
  .sidebar {
    width: 220px;
  }

  .page-container {
    padding: 30px 25px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .sidebar {
    position: fixed;
    z-index: 20;
    top: 0;
    bottom: 0;
    left: 0;
    transform: translateX(-100%);
    transition: transform 0.25s ease;
    box-shadow: 8px 0 30px #17203312;
  }

  .sidebar-open {
    transform: translateX(0);
  }

  .mobile-overlay {
    display: block;
    position: fixed;
    inset: 0;
    background: #17203370;
    z-index: 19;
  }

  .mobile-close,
  .menu-toggle {
    display: grid;
  }

  .brand {
    flex: 1;
  }

  .topbar {
    padding: 0 17px;
    height: 62px;
  }

  .topbar-left,
  .topbar-right {
    gap: 11px;
  }

  .topbar-status {
    display: none;
  }

  .page-container {
    padding: 25px 16px;
  }

  .page-heading h2 {
    font-size: 22px;
  }

  .welcome-panel {
    padding: 24px;
  }

  .welcome-panel h3 {
    font-size: 19px;
  }

  .welcome-art {
    display: none;
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }

  .toolbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .toolbar-actions {
    width: 100%;
    flex-wrap: wrap;
  }

  .search-box {
    flex: 1;
  }

  .search-box input {
    width: 100%;
  }
}

@media (max-width: 480px) {
  .stats-grid,
  .form-grid {
    grid-template-columns: 1fr;
  }

  .data-status {
    display: none;
  }

  .welcome-panel p {
    font-size: 11px;
  }

  .page-card {
    padding: 15px;
  }

  .form-footer {
    align-items: flex-start;
    flex-direction: column;
    gap: 13px;
  }

  .app-footer {
    gap: 12px;
    flex-direction: column;
  }

  .ai-powered-label {
    display: none;
  }
}
.lead-summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 15px;
  margin-bottom: 20px;
}

.lead-summary-card {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 17px;
  background: #fff;
  border: 1px solid #e9edf4;
  border-radius: 10px;
}

.lead-summary-icon {
  width: 39px;
  height: 39px;
  display: grid;
  place-items: center;
  border-radius: 9px;
}

.lead-summary-card > div:last-child {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.lead-summary-card span {
  font-size: 11px;
  color: #8792a5;
}

.lead-summary-card strong {
  font-size: 20px;
  color: #273957;
}

.refresh-button,
.clear-search {
  border: 1px solid #e7ebf2;
  background: white;
  color: #75849a;
  border-radius: 7px;
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
}

.feedback {
  margin-top: 16px;
  padding: 11px 13px;
  border-radius: 7px;
  font-size: 11px;
}

.success-feedback {
  color: #18764e;
  background: #edf8f2;
  border: 1px solid #d4eddf;
}

.error-feedback {
  color: #b42335;
  background: #fff1f2;
  border: 1px solid #f8d7dc;
}

.loading-state {
  min-height: 250px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 11px;
  color: #8290a7;
  font-size: 12px;
}

.spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.table-scroll {
  width: 100%;
  overflow-x: auto;
  margin-top: 20px;
}

.leads-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  white-space: nowrap;
}

.leads-table th {
  background: #f8f9fc;
  padding: 13px 12px;
  color: #8b97a9;
  font-size: 9px;
  letter-spacing: 0.65px;
  font-weight: 750;
}

.leads-table td {
  padding: 14px 12px;
  border-bottom: 1px solid #edf0f5;
  color: #58677e;
  font-size: 11px;
}

.lead-name-cell,
.company-cell {
  display: flex;
  align-items: center;
  gap: 9px;
}

.lead-name-cell > div:last-child {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.lead-name-cell strong {
  color: #34445f;
  font-size: 11px;
}

.lead-name-cell span {
  font-size: 9px;
  color: #9aa5b5;
}

.lead-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #edf3fc;
  color: #416b9e;
  display: grid;
  place-items: center;
  font-weight: 750;
}

.company-cell svg {
  color: #95a3b6;
}

.date-cell {
  color: #8592a5 !important;
}

.table-actions {
  display: flex;
  align-items: center;
  gap: 7px;
}

.action-button {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border: 1px solid #e9edf4;
  border-radius: 6px;
  background: #fff;
}

.edit-action {
  color: #4773ad;
}

.delete-action {
  color: #c45d68;
}

.table-bottom {
  padding: 13px 12px;
  font-size: 10px;
  color: #929daf;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 40;
  background: #15243d77;
  display: grid;
  place-items: center;
  padding: 20px;
}

.lead-modal {
  width: 100%;
  max-width: 470px;
  background: #fff;
  border-radius: 13px;
  padding: 24px;
  box-shadow: 0 20px 70px #17203330;
}

.modal-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 22px;
}

.modal-heading h3 {
  margin: 0;
  color: #273957;
  font-size: 17px;
}

.modal-heading p {
  color: #8995a8;
  font-size: 11px;
  margin: 7px 0 0;
}

.lead-modal form {
  display: flex;
  flex-direction: column;
  gap: 17px;
}

.lead-modal .field input {
  background: #fff;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  padding-top: 9px;
}

.cancel-button {
  border: 1px solid #e5eaf1;
  border-radius: 7px;
  background: #fff;
  color: #66758c;
