.lead-notes-field {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-top: 15px;
}

.lead-notes-field textarea {
  resize: vertical;
  min-height: 95px;
  padding: 11px 12px;
  border: 1px solid #dfe3ea;
  border-radius: 7px;
  font: inherit;
  font-size: 13px;
  outline: none;
}

.lead-notes-count {
  align-self: flex-end;
  color: #98a2b3;
  font-size: 11px;
}

@media (max-width: 640px) {
  .lead-filter-bar {
    align-items: stretch;
  }

  .lead-filter-label {
    width: 100%;
  }

  .lead-filter-bar select {
    flex: 1;
    min-width: 0;
  }

  .lead-form-grid {
    grid-template-columns: 1fr;
  }

  .enhanced-lead-modal {
    padding: 18px;
  }
}



/* Enterprise dashboard analytics */

.dashboard-primary-action,
.dashboard-text-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 0;
  cursor: pointer;
  font: inherit;
}

.dashboard-primary-action {
  margin-top: 17px;
  padding: 10px 14px;
  border-radius: 8px;
  background: #ffffff;
  color: #23456f;
  font-size: 12px;
  font-weight: 700;
}

.dashboard-primary-action:hover {
  background: #edf3fb;
}

.dashboard-section-heading {
  margin-top: 27px;
}

.dashboard-kpi-grid {
  margin-bottom: 20px;
}

.dashboard-analytics-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.85fr);
  gap: 20px;
  margin-top: 20px;
}

.dashboard-analytics-card,
.dashboard-followup-card,
.dashboard-recent-leads-card,
.dashboard-latest-call,
.dashboard-quick-card {
  min-width: 0;
}

.dashboard-total-pill {
  padding: 6px 10px;
  border-radius: 20px;
  background: #f1f5fa;
  color: #63748c;
  font-size: 11px;
  font-weight: 650;
  white-space: nowrap;
}

.pipeline-list {
  display: flex;
  flex-direction: column;
  gap: 17px;
  margin-top: 24px;
}

.pipeline-row {
  display: grid;
  grid-template-columns: 112px minmax(50px, 1fr) 45px;
  align-items: center;
  gap: 13px;
}

.pipeline-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 7px;
  color: #52637b;
  font-size: 11px;
}

.pipeline-label strong {
  color: #2e405b;
  font-size: 12px;
}

.pipeline-name {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.pipeline-dot,
.priority-legend-item i {
  display: inline-block;
  width: 8px;
  height: 8px;
  flex: 0 0 8px;
  border-radius: 50%;
}

.pipeline-track {
  height: 8px;
  overflow: hidden;
  border-radius: 10px;
  background: #eff2f6;
}

.pipeline-fill {
  height: 100%;
  min-width: 0;
  border-radius: inherit;
  transition: width 0.3s ease;
}

.pipeline-percentage {
  color: #8a97a9;
  font-size: 10px;
  text-align: right;
}

.priority-total {
  display: flex;
  align-items: baseline;
  gap: 9px;
  margin: 25px 0 18px;
}

.priority-total strong {
  color: #263b59;
  font-size: 32px;
  font-weight: 750;
  letter-spacing: -1px;
}

.priority-total span {
  color: #8793a5;
  font-size: 11px;
}

.priority-stack {
  display: flex;
  height: 13px;
  overflow: hidden;
  border-radius: 10px;
  background: #eff2f6;
}

.priority-stack-segment {
  min-width: 0;
  transition: width 0.3s ease;
}

.priority-legend {
  display: flex;
  flex-direction: column;
  gap: 15px;
  margin-top: 23px;
}

.priority-legend-item,
.priority-legend-item > span {
  display: flex;
  align-items: center;
}

.priority-legend-item {
  justify-content: space-between;
  color: #617087;
  font-size: 11px;
}

.priority-legend-item > span {
  gap: 9px;
}

.priority-legend-item strong {
  color: #334762;
  font-size: 12px;
}

.dashboard-followup-card,
.dashboard-recent-leads-card {
  margin-top: 20px;
}

.dashboard-text-action {
  padding: 5px 0;
  background: transparent;
  color: #456f9f;
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}

.dashboard-text-action:hover {
  color: #244c7b;
}

.followup-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 13px;
  margin-top: 20px;
}

.followup-item {
  min-width: 0;
  padding: 16px;
  border: 1px solid #edf0f5;
  border-radius: 10px;
  background: #fbfcfe;
}

.followup-icon {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  margin-bottom: 12px;
  border-radius: 9px;
}

.followup-item.overdue .followup-icon {
  background: #fff0ef;
  color: #bd6266;
}

.followup-item.today .followup-icon {
  background: #fff5e9;
  color: #c58a3b;
}

.followup-item.upcoming .followup-icon {
  background: #eaf6f0;
  color: #38936e;
}

.followup-value {
  color: #2c405e;
  font-size: 25px;
  font-weight: 750;
}

.followup-item > strong,
.followup-item > span {
  display: block;
}

.followup-item > strong {
  margin-top: 3px;
  color: #52637b;
  font-size: 11px;
}

.followup-item > span {
  margin-top: 5px;
  color: #929daf;
  font-size: 10px;
}

.dashboard-table-wrap {
  width: 100%;
  overflow-x: auto;
  margin-top: 15px;
}

.dashboard-recent-table {
  width: 100%;
  min-width: 650px;
  text-align: left;
}

.dashboard-recent-table th {
  padding: 12px 13px;
  background: #f8fafd;
  color: #77869b;
  font-size: 10px;
  font-weight: 700;
  white-space: nowrap;
}

.dashboard-recent-table td {
  padding: 13px;
  border-bottom: 1px solid #edf0f5;
  color: #718097;
  font-size: 11px;
  white-space: nowrap;
}

.dashboard-recent-table tbody tr:last-child td {
  border-bottom: 0;
}

.dashboard-recent-table td strong {
  color: #344862;
  font-weight: 650;
}

.dashboard-status-tag,
.dashboard-priority-tag {
  display: inline-flex;
  align-items: center;
  padding: 5px 8px;
  border-radius: 20px;
  font-size: 10px;
  font-weight: 650;
}

.dashboard-status-tag.status-new {
  background: #edf3fc;
  color: #5376a7;
}

.dashboard-status-tag.status-contacted {
  background: #f1edfa;
  color: #8169ae;
}

.dashboard-status-tag.status-interested {
  background: #fff5e8;
  color: #b17d31;
}

.dashboard-status-tag.status-converted {
  background: #eaf6ef;
  color: #32865f;
}

.dashboard-status-tag.status-lost {
  background: #fbeeee;
  color: #b45d64;
}

.dashboard-priority-tag.priority-high {
  background: #fbeeee;
  color: #b45d64;
}

.dashboard-priority-tag.priority-medium {
  background: #fff5e8;
  color: #b17d31;
}

.dashboard-priority-tag.priority-low {
  background: #eaf6ef;
  color: #32865f;
}

.dashboard-bottom-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  gap: 20px;
  margin-top: 20px;
}

.dashboard-call-icon {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: #edf3fc;
  color: #5376a7;
}

.latest-call-content {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin: 22px 0 15px;
}

.latest-call-content strong {
  color: #30445f;
  font-size: 14px;
}

.latest-call-content > span {
  color: #8290a3;
  font-size: 11px;
}

.latest-call-content small {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 6px;
  color: #8491a3;
  font-size: 10px;
}

.dashboard-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 170px;
  color: #8c99ab;
  text-align: center;
  font-size: 11px;
}

.dashboard-empty strong {
  color: #465a75;
  font-size: 13px;
}

.dashboard-empty.compact {
  min-height: 95px;
}

.dashboard-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 150px;
  color: #8290a3;
  font-size: 11px;
}

.dashboard-latest-call > .dashboard-text-action {
  margin-top: 5px;
}

@media (max-width: 900px) {
  .dashboard-analytics-grid,
  .dashboard-bottom-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .followup-grid {
    grid-template-columns: 1fr;
  }

  .followup-item {
    display: grid;
    grid-template-columns: 38px 1fr;
    align-items: center;
    column-gap: 12px;
  }

  .followup-icon {
    grid-row: span 3;
    margin: 0;
  }

  .followup-value {
    font-size: 22px;
  }

  .pipeline-row {
    grid-template-columns: 100px minmax(35px, 1fr) 38px;
    gap: 8px;
  }

  .dashboard-analytics-card,
  .dashboard-followup-card,
  .dashboard-recent-leads-card,
  .dashboard-latest-call,
  .dashboard-quick-card {
    padding: 17px;
  }
}


/* Customer 360 lead profile */

.lead-details-page {
  display: flex;
  flex-direction: column;
  gap: 19px;
}

.lead-details-back {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  gap: 8px;
  padding: 7px 0;
  border: 0;
  background: transparent;
  color: #587397;
  cursor: pointer;
  font-size: 12px;
  font-weight: 650;
}

.lead-details-back:hover {
  color: #234b7b;
}

.lead-details-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.lead-details-heading h2 {
  margin: 7px 0 5px;
  color: var(--enterprise-text, #263b59);
  font-size: 25px;
}

.lead-details-heading p {
  margin: 0;
  color: var(--enterprise-muted, #8290a3);
  font-size: 12px;
}

.customer-profile-card,
.customer-notes-card,
.customer-timeline-card {
  padding: 22px;
}

.customer-profile-identity {
  display: flex;
  align-items: center;
  gap: 13px;
}

.customer-profile-avatar {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background: #edf3fc;
  color: #315f99;
  font-size: 19px;
  font-weight: 750;
}

.customer-profile-identity h3 {
  margin: 0 0 5px;
  color: #30445f;
  font-size: 17px;
}

.customer-profile-identity span {
  color: #8b98aa;
  font-size: 11px;
}

.customer-profile-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 18px;
}

.customer-profile-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  margin-top: 23px;
  padding-top: 20px;
  border-top: 1px solid #edf0f5;
}

.customer-profile-field {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  min-width: 0;
  color: #7890ad;
}

.customer-profile-field > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
  min-width: 0;
}

.customer-profile-field span {
  color: #8b98aa;
  font-size: 10px;
}

.customer-profile-field strong {
  overflow-wrap: anywhere;
  color: #3b4f69;
  font-size: 12px;
  font-weight: 650;
}

.customer-notes-card .card-heading > svg {
  color: #7890ad;
}

.customer-notes-content {
  margin: 17px 0 0;
  padding: 14px;
  border-radius: 9px;
  background: #f8fafd;
  color: #586a82;
  font-size: 12px;
  line-height: 1.7;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.customer-notes-empty {
  margin-top: 16px;
  padding: 15px;
  border: 1px dashed #dce4ee;
  border-radius: 9px;
  color: #8996a8;
  font-size: 11px;
}

.lead-details-refresh {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border: 1px solid #e4eaf2;
  border-radius: 8px;
  background: #fff;
  color: #607b9d;
  cursor: pointer;
}

.lead-details-refresh:hover {
  background: #f5f8fc;
}

.customer-timeline {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-top: 23px;
}

.customer-timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 34px minmax(0, 1fr);
  gap: 13px;
}

.customer-timeline-item:not(:last-child)::after {
  position: absolute;
  top: 35px;
  bottom: -23px;
  left: 16px;
  width: 1px;
  background: #e5ebf3;
  content: "";
}

.customer-timeline-marker {
  position: relative;
  z-index: 1;
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border: 1px solid #dce7f5;
  border-radius: 10px;
  background: #f0f5fc;
  color: #5379a7;
}

.customer-call-card {
  min-width: 0;
  padding: 17px;
  border: 1px solid #e9edf4;
  border-radius: 11px;
  background: #fff;
}

.customer-call-heading {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 14px;
  border-bottom: 1px solid #edf0f5;
}

.customer-call-heading > div {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.customer-call-heading strong {
  color: #344862;
  font-size: 12px;
}

.customer-call-heading span,
.customer-call-heading small {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #8996a8;
  font-size: 10px;
}

.customer-call-heading small {
  text-align: right;
}

.customer-call-section {
  margin-top: 15px;
}

.customer-call-section h4,
.customer-ai-summary h4 {
  display: flex;
  align-items: center;
  gap: 7px;
  margin: 0 0 7px;
  color: #63748b;
  font-size: 10px;
  font-weight: 750;
  text-transform: uppercase;
  letter-spacing: 0.35px;
}

.customer-call-section p,
.customer-ai-summary p {
  margin: 0;
  color: #566982;
  font-size: 11px;
  line-height: 1.7;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.customer-ai-summary {
  margin-top: 15px;
  padding: 13px;
  border: 1px solid #e5eaf5;
  border-radius: 9px;
  background: #f7f9fd;
}

.customer-ai-summary h4 {
  color: #6c69a0;
}

.customer-timeline-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9px;
  padding: 35px 15px;
  color: #8996a8;
  text-align: center;
}

.customer-timeline-empty-icon {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background: #f0f5fc;
  color: #6485ae;
}

.customer-timeline-empty strong {
  color: #455a75;
  font-size: 13px;
}

.customer-timeline-empty span {
  max-width: 340px;
  font-size: 11px;
  line-height: 1.6;
}

.customer-profile-footer {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #8c99aa;
  font-size: 10px;
}

.lead-details-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 11px;
  min-height: 280px;
  color: #7e8da2;
  font-size: 12px;
}

.lead-profile-link {
  padding: 0;
  border: 0;
  background: transparent;
  color: #304c72;
  cursor: pointer;
  font: inherit;
  font-size: 11px;
  font-weight: 700;
  text-align: left;
}

.lead-profile-link:hover {
  color: #4778b3;
  text-decoration: underline;
}

@media (max-width: 600px) {
  .lead-details-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .customer-profile-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .customer-profile-card,
  .customer-notes-card,
  .customer-timeline-card {
    padding: 16px;
  }

  .customer-call-heading {
    flex-direction: column;
  }

  .customer-call-heading small {
    text-align: left;
  }
}



/* Dashboard KPI layout: five metrics with responsive breakpoints */
.dashboard-kpi-grid {
  grid-template-columns: repeat(5, minmax(0, 1fr));
}

@media (max-width: 1100px) {
  .dashboard-kpi-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .dashboard-kpi-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 480px) {
  .dashboard-kpi-grid {
    grid-template-columns: 1fr;
  }
}



/* Follow-up management quick filters */
.followup-quick-filters {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 14px;
  margin: 0 0 18px;
  padding: 15px 18px;
  background: #ffffff;
  border: 1px solid #e8edf4;
  border-radius: 12px;
}

.followup-quick-heading {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #34445e;
  font-size: 13px;
  font-weight: 700;
}

.followup-quick-heading svg {
  color: #647b9e;
}

.followup-quick-options {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}

.followup-quick-button {
  min-height: 34px;
  padding: 7px 12px;
  border: 1px solid #e1e7ef;
  border-radius: 7px;
  background: #ffffff;
  color: #526178;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.followup-quick-button:hover,
.followup-quick-button.active {
  border-color: #8295b2;
  background: #f0f4f9;
  color: #263e60;
}

.followup-quick-button.filter-overdue.active {
  border-color: #e5b8b8;
  background: #fff3f2;
  color: #a64f53;
}

.followup-quick-button.filter-today.active {
  border-color: #ead2a9;
  background: #fff8eb;
  color: #956a29;
}

.followup-quick-button.filter-upcoming.active {
  border-color: #b8ddca;
  background: #eff8f3;
  color: #347b59;
}

@media (max-width: 640px) {
  .followup-quick-filters {
    align-items: flex-start;
    flex-direction: column;
  }

  .followup-quick-options {
    width: 100%;
  }
}
