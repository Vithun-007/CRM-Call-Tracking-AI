/* =========================================================
   ENTERPRISE DESIGN LAYER - V1
   Shared visual refinement for all CRM pages
   ========================================================= */

:root {
  --enterprise-navy: #173b70;
  --enterprise-navy-dark: #122e56;
  --enterprise-blue: #3268a8;
  --enterprise-text: #1d2d45;
  --enterprise-muted: #718096;
  --enterprise-border: #e5eaf2;
  --enterprise-surface: #ffffff;
  --enterprise-background: #f5f7fb;
  --enterprise-shadow: 0 3px 12px rgba(25, 45, 75, 0.045);
  --enterprise-shadow-hover: 0 8px 22px rgba(25, 45, 75, 0.085);
}

/* Main workspace */

.app-layout {
  background: var(--enterprise-background);
}

.sidebar {
  width: 252px;
  padding: 26px 16px 18px;
  border-right-color: var(--enterprise-border);
}

.brand {
  padding-bottom: 36px;
}

.brand-icon {
  border-radius: 12px;
  box-shadow: 0 3px 8px rgba(23, 59, 112, 0.16);
}

.navigation {
  gap: 5px;
}

.nav-item {
  min-height: 42px;
  border-radius: 9px;
  transition: background 0.18s ease, color 0.18s ease;
}

.nav-item:hover {
  background: #f1f5fb;
}

.nav-active {
  background: #eaf1fb;
  color: var(--enterprise-navy);
}

.main-area {
  background: var(--enterprise-background);
}

.topbar {
  height: 68px;
  padding: 0 36px;
  border-bottom-color: var(--enterprise-border);
  box-shadow: 0 1px 3px rgba(25, 45, 75, 0.025);
}

.topbar-left,
.topbar-right {
  gap: 17px;
}

.page-container {
  width: 100%;
  max-width: 1680px;
  margin: 0 auto;
  padding: 36px 44px 28px;
}

/* Page headings */

.page-heading {
  margin-bottom: 28px;
}

.page-heading h2 {
  color: var(--enterprise-text);
  font-size: 27px;
  letter-spacing: -0.7px;
  line-height: 1.3;
}

.page-heading p {
  color: var(--enterprise-muted);
  font-size: 13px;
  line-height: 1.6;
}

.eyebrow {
  color: #5276a5;
  font-size: 10px;
  letter-spacing: 1.35px;
}

/* Shared cards */

.stat-card,
.content-card,
.page-card {
  background: var(--enterprise-surface);
  border: 1px solid var(--enterprise-border);
  border-radius: 13px;
  box-shadow: var(--enterprise-shadow);
}

.stat-card {
  padding: 21px;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.stat-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--enterprise-shadow-hover);
}

.content-card {
  padding: 23px;
}

.stat-value {
  color: var(--enterprise-text);
  font-size: 27px;
  letter-spacing: -0.5px;
  font-weight: 750;
}

.stat-top {
  font-size: 12px;
  font-weight: 550;
}

.stat-icon,
.quick-icon {
  border-radius: 10px;
}

/* Dashboard */

.welcome-panel {
  border-radius: 15px;
  box-shadow: 0 7px 20px rgba(23, 59, 112, 0.10);
}

.dashboard-grid {
  gap: 20px;
}

.quick-action {
  border-color: var(--enterprise-border);
  border-radius: 10px;
  transition: background 0.18s ease, border-color 0.18s ease;
}

.quick-action:hover {
  background: #f8faff;
  border-color: #d7e2f1;
}

.ai-card {
  background: #f7f9fe;
  border-color: #e2eaf6;
  border-radius: 13px;
}

/* Forms and interactive controls */

input,
select,
textarea {
  border-color: #dce4ef;
}

input:focus,
select:focus,
textarea:focus {
  border-color: #6b91c3;
  outline: none;
  box-shadow: 0 0 0 3px rgba(65, 117, 181, 0.10);
}

button {
  transition: background 0.18s ease, border-color 0.18s ease,
    box-shadow 0.18s ease, transform 0.18s ease;
}

button:focus-visible {
  outline: 3px solid rgba(65, 117, 181, 0.25);
  outline-offset: 2px;
}

/* Tables */

table {
  border-collapse: separate;
  border-spacing: 0;
}

thead th {
  color: #66758c;
  font-weight: 700;
  letter-spacing: 0.35px;
}

tbody tr {
  transition: background 0.15s ease;
}

tbody tr:hover {
  background: #f8faff;
}

/* Footer */

.app-footer {
  border-top-color: var(--enterprise-border);
  color: #8794a8;
}

/* Tablet */

@media (max-width: 1050px) {
  .sidebar {
    width: 220px;
  }

  .page-container {
    padding: 30px 26px 24px;
  }
}

/* Mobile */

@media (max-width: 760px) {
  .topbar {
    padding: 0 17px;
  }

  .page-container {
    padding: 25px 16px;
  }

  .page-heading {
    gap: 14px;
    flex-wrap: wrap;
  }

  .page-heading h2 {
    font-size: 23px;
  }

  .content-card {
    padding: 17px;
  }
}

@media (max-width: 480px) {
  .page-container {
    padding: 20px 13px;
  }

  .page-heading h2 {
    font-size: 21px;
  }

  .stat-card {
    padding: 17px;
  }
}


