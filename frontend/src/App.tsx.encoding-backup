import { useEffect, useState } from "react";
import {
  LayoutDashboard,
  Users,
  PhoneCall,
  History,
  Bell,
  Plus,
  ArrowUpRight,
  Sparkles,
  ChevronDown,
  Menu,
  X,
  BriefcaseBusiness,
  Clock3,
  Activity,
  LoaderCircle,
  RefreshCw,
} from "lucide-react";

import LeadsPage from "./pages/LeadsPage";
import CallTrackingPage from "./pages/CallTrackingPage";
import CallHistoryPage from "./pages/CallHistoryPage";

import {
  getDashboardSummary,
  type DashboardSummary,
} from "./services/dashboardService";

type Page = "Dashboard" | "Leads" | "Call Tracking" | "Call History";

const navigation = [
  { name: "Dashboard" as Page, icon: LayoutDashboard },
  { name: "Leads" as Page, icon: Users },
  { name: "Call Tracking" as Page, icon: PhoneCall },
  { name: "Call History" as Page, icon: History },
];

function Sidebar({
  activePage,
  setActivePage,
  mobileOpen,
  setMobileOpen,
}: {
  activePage: Page;
  setActivePage: (page: Page) => void;
  mobileOpen: boolean;
  setMobileOpen: (open: boolean) => void;
}) {
  return (
    <>
      {mobileOpen && (
        <div
          className="mobile-overlay"
          onClick={() => setMobileOpen(false)}
        />
      )}

      <aside className={`sidebar ${mobileOpen ? "sidebar-open" : ""}`}>
        <div className="brand">
          <div className="brand-icon">
            <BriefcaseBusiness size={21} />
          </div>
          <div>
            <h1>INDIUM CRM</h1>
            <span>Lead Management</span>
          </div>
          <button
            className="mobile-close"
            onClick={() => setMobileOpen(false)}
            aria-label="Close navigation"
          >
            <X size={20} />
          </button>
        </div>

        <div className="nav-label">WORKSPACE</div>

        <nav className="navigation">
          {navigation.map(({ name, icon: Icon }) => (
            <button
              key={name}
              className={`nav-item ${
                activePage === name ? "nav-active" : ""
              }`}
              onClick={() => {
                setActivePage(name);
                setMobileOpen(false);
              }}
            >
              <Icon size={19} strokeWidth={1.8} />
              <span>{name}</span>
            </button>
          ))}
        </nav>

        <div className="sidebar-bottom">
          <div className="sidebar-help">
            <div className="help-icon">
              <Sparkles size={19} />
            </div>
            <h3>AI-powered CRM</h3>
            <p>
              Turn your call notes into clear, professional
              business summaries.
            </p>
          </div>

          <div className="profile">
            <div className="avatar">U</div>
            <div className="profile-info">
              <strong>CRM User</strong>
              <span>Workspace member</span>
            </div>
            <ChevronDown size={16} />
          </div>
        </div>
      </aside>
    </>
  );
}

function PageHeading({
  eyebrow,
  title,
  description,
}: {
  eyebrow: string;
  title: string;
  description: string;
}) {
  return (
    <div className="page-heading">
      <div>
        <div className="eyebrow">{eyebrow}</div>
        <h2>{title}</h2>
        <p>{description}</p>
      </div>
    </div>
  );
}

function formatActivityDate(value: string | null): string {
  if (!value) return "No activity yet";

  const date = new Date(`${value}T00:00:00`);

  if (Number.isNaN(date.getTime())) return value;

  return date.toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

function Dashboard({
  onNavigate,
}: {
  onNavigate: (page: Page) => void;
}) {
  const [summary, setSummary] = useState<DashboardSummary | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const loadDashboard = async () => {
    setLoading(true);
    setError("");

    try {
      const data = await getDashboardSummary();
      setSummary(data);
    } catch (err) {
      const message =
        err instanceof Error ? err.message : "Unable to load dashboard data.";
      setError(message);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    void loadDashboard();
  }, []);

  const stats = [
    {
      label: "Total Leads",
      value: summary?.total_leads,
      icon: Users,
      color: "blue",
      note: "Registered customer leads",
    },
    {
      label: "Calls Recorded",
      value: summary?.calls_recorded,
      icon: PhoneCall,
      color: "purple",
      note: "Saved call interactions",
    },
    {
      label: "Interactions",
      value: summary?.interactions,
      icon: Activity,
      color: "green",
      note: "Unique leads contacted",
    },
    {
      label: "Recent Activity",
      value: summary?.latest_activity
        ? formatActivityDate(summary.latest_activity.call_date)
        : "—",
      icon: Clock3,
      color: "orange",
      note: summary?.latest_activity
        ? summary.latest_activity.lead_name
        : "No calls recorded yet",
    },
  ];

  return (
    <>
      <PageHeading
        eyebrow="OVERVIEW"
        title="Dashboard"
        description="Welcome to your CRM workspace. Manage leads and track business interactions."
      />

      <div className="welcome-panel">
        <div>
          <div className="welcome-tag">
            <Sparkles size={15} /> INTELLIGENT CALL MANAGEMENT
          </div>
          <h3>Build better customer relationships.</h3>
          <p>
            Organize your leads, document conversations and
            transform shorthand call notes into professional
            summaries with AI.
          </p>
        </div>
        <div className="welcome-art">
          <div className="art-circle">
            <PhoneCall size={39} />
          </div>
          <Sparkles className="art-sparkle" size={24} />
        </div>
      </div>

      <div className="section-heading">
        <div>
          <h3>Workspace overview</h3>
          <p>Your CRM activity at a glance</p>
        </div>

        <div className="dashboard-status-area">
          <span className="data-status">
            <span className={`status-dot ${error ? "status-error" : ""}`} />
            {error ? "Connection issue" : "Live database data"}
          </span>
          <button
            type="button"
            className="dashboard-refresh"
            onClick={() => void loadDashboard()}
            disabled={loading}
            title="Refresh dashboard"
            aria-label="Refresh dashboard"
          >
            {loading ? (
              <LoaderCircle size={16} className="spin-icon" />
            ) : (
              <RefreshCw size={16} />
            )}
          </button>
        </div>
      </div>

      {error && (
        <div className="form-alert error-alert">
          Unable to retrieve dashboard statistics: {error}
          <button type="button" onClick={() => void loadDashboard()}>
            Retry
          </button>
        </div>
      )}

      <div className="stats-grid">
        {stats.map(({ label, value, icon: Icon, color, note }) => (
          <div className="stat-card" key={label}>
            <div className="stat-top">
              <span>{label}</span>
              <div className={`stat-icon ${color}`}>
                <Icon size={19} />
              </div>
            </div>
            <div className="stat-value dashboard-stat-value">
              {loading ? (
                <LoaderCircle size={21} className="spin-icon" />
              ) : (
                value ?? "—"
              )}
            </div>
            <div className="stat-note">{note}</div>
          </div>
        ))}
      </div>

      {summary?.latest_activity && (
        <div className="dashboard-recent-activity">
          <div className="recent-activity-icon">
            <PhoneCall size={18} />
          </div>
          <div className="recent-activity-content">
            <strong>Latest recorded interaction</strong>
            <span>
              {summary.latest_activity.lead_name} ·{" "}
              {summary.latest_activity.company}
            </span>
          </div>
          <span className="recent-activity-date">
            {formatActivityDate(summary.latest_activity.call_date)}
          </span>
        </div>
      )}

      <div className="dashboard-grid">
        <div className="content-card quick-card">
          <div className="card-heading">
            <div>
              <h3>Quick actions</h3>
              <p>Access your everyday CRM activities</p>
            </div>
          </div>

          <div className="quick-actions">
            <button
              type="button"
              className="quick-action quick-action-button"
              onClick={() => onNavigate("Leads")}
            >
              <div className="quick-icon blue">
                <Plus size={20} />
              </div>
              <div>
                <strong>Manage leads</strong>
                <span>Create and organize your leads</span>
              </div>
              <ArrowUpRight size={18} />
            </button>

            <button
              type="button"
              className="quick-action quick-action-button"
              onClick={() => onNavigate("Call Tracking")}
            >
              <div className="quick-icon purple">
                <PhoneCall size={20} />
              </div>
              <div>
                <strong>Record a call</strong>
                <span>Document a customer interaction</span>
              </div>
              <ArrowUpRight size={18} />
            </button>
          </div>
        </div>

        <div className="content-card ai-card">
          <div className="ai-card-icon">
            <Sparkles size={22} />
          </div>
          <div className="ai-label">AI ASSISTANT</div>
          <h3>Smarter call documentation</h3>
          <p>
            Convert shorthand notes into structured,
            professional summaries while keeping the
            original information available for review.
          </p>
          <div className="ai-feature">
            <span><Activity size={15} /> LangChain orchestration</span>
            <span><Sparkles size={15} /> Groq-powered summaries</span>
          </div>
        </div>
      </div>
    </>
  );
}

function App() {
  const [activePage, setActivePage] = useState<Page>("Dashboard");
  const [mobileOpen, setMobileOpen] = useState(false);

  const renderPage = () => {
    switch (activePage) {
      case "Leads":
        return <LeadsPage />;
      case "Call Tracking":
        return <CallTrackingPage />;
      case "Call History":
        return <CallHistoryPage />;
      default:
        return <Dashboard onNavigate={setActivePage} />;
    }
  };

  return (
    <div className="app-layout">
      <Sidebar
        activePage={activePage}
        setActivePage={setActivePage}
        mobileOpen={mobileOpen}
        setMobileOpen={setMobileOpen}
      />

      <main className="main-area">
        <header className="topbar">
          <div className="topbar-left">
            <button
              className="menu-toggle"
              onClick={() => setMobileOpen(true)}
              aria-label="Open navigation"
            >
              <Menu size={21} />
            </button>
            <div className="breadcrumb">
              Workspace <span>/</span> <strong>{activePage}</strong>
            </div>
          </div>

          <div className="topbar-right">
            <div className="topbar-status">
              <span className="status-dot" />
              CRM Workspace
            </div>
            <button className="icon-button" aria-label="Notifications">
              <Bell size={19} />
            </button>
            <div className="top-avatar">U</div>
          </div>
        </header>

        <div className="page-container">
          {renderPage()}

          <footer className="app-footer">
            <span>INDIUM CRM</span>
            <span>AI-Powered Lead & Call Tracking</span>
          </footer>
        </div>
      </main>
    </div>
  );
}

export default App;
